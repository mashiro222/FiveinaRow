{
  "name": "five-in-a-row",
  "version": "1.4.1",
  "description": "弈间 · 五子棋、人机对弈、好友联机与开局研习",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "mashiro222",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui.mjs",
    "test:study": "node tests/study-ui.mjs",
    "test:appearance": "node tests/appearance-ui.mjs",
    "build:openings": "node scripts/analyze-openings.mjs && node scripts/enrich-openings.mjs && node scripts/build-opening-lines.mjs",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "build:engine": "node scripts/build-engine.mjs",
    "test:native": "node scripts/test-native.mjs",
    "benchmark:ai": "node scripts/benchmark-ai.mjs",
    "benchmark:strength": "node scripts/benchmark-strength.mjs",
    "server": "node server/index.mjs",
    "test:online": "node tests/online-ui.mjs",
    "test:public": "node tests/public-online-ui.mjs"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "io.github.mashiro222.fiveinarow",
    "productName": "Five in a Row",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "src/**/*",
      "assets/**/*",
      "electron/**/*",
      "package.json",
      "server/**/*"
    ],
    "mac": {
      "category": "public.app-category.board-games",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "icon": "assets/icon.png",
      "hardenedRuntime": false,
      "notarize": false,
      "binaries": [
        "Contents/Resources/rapfi/pbrain-rapfi"
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "用于连接同一网络内的五子棋房间和邀请朋友对弈。"
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Five-in-a-Row-${version}-win-${arch}-Setup.${ext}"
    },
    "artifactName": "Five-in-a-Row-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "Five-in-a-Row-${version}-win-${arch}-Portable.${ext}"
    },
    "beforePack": "scripts/before-pack.cjs",
    "extraResources": [
      {
        "from": "native/rapfi",
        "to": "rapfi"
      },
      {
        "from": "third_party/rapfi",
        "to": "licenses/rapfi",
        "filter": [
          "**/*",
          "!networks/**/*",
          "!rapfi-model210901.bin"
        ]
      },
      {
        "from": "scripts/build-engine.mjs",
        "to": "licenses/rapfi/build-engine.mjs"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "licenses/APP-LICENSE.txt"
      }
    ]
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
