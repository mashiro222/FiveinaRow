{
  "name": "five-in-a-row",
  "version": "1.0.1",
  "description": "弈间 · 离线五子棋与开局研习",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "mashiro222",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui.mjs",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "io.github.mashiro222.fiveinarow",
    "productName": "Five in a Row",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "src/**/*",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.board-games",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "icon": "assets/icon.png",
      "hardenedRuntime": false,
      "notarize": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Five-in-a-Row-${version}-win-${arch}-Setup.${ext}"
    },
    "artifactName": "Five-in-a-Row-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "Five-in-a-Row-${version}-win-${arch}-Portable.${ext}"
    }
  }
}
